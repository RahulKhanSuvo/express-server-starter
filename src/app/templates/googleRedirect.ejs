<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Successful</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
        }

        .container {
            text-align: center;
            background-color: #fff;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            color: #4CAF50;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>redirecting...</h2>
    </div>
    <script>
        (async () => {
            try {
                const response = await fetch(`<%=batterAuthUrl %>/api/auth/sign-in/social`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    credentials: "include",
                    body: JSON.stringify({
                        provider: "google",
                        callbackUrl: "<%=callbackUrl%>"
                    })
                });
                const data = await response.json();
                console.log(data);
                if (data.url) {
                    window.location.href = data.url;
                } else {
                    document.body.innerHTML = `
                    <div class="container">
                        <h2>Login Failed</h2>
                        <h3>${data.message}</h3>
                    </div>  
                    `;
                }

            } catch (error) {
                document.body.innerHTML = `
                <div class="container">
                    <h2>something went wrong</h2>
                    <h3>${error}</h3>
                </div>
                `;
            }
        })();
    </script>
</body>

</html>