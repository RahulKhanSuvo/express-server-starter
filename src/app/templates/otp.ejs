<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <title>OTP Verification</title>
</head>

<body style="margin:0; padding:0; font-family: Arial, sans-serif; background:#f6f7fb;">

    <div
        style="max-width:520px; margin:40px auto; background:#ffffff; border-radius:12px; padding:32px; box-shadow:0 8px 24px rgba(0,0,0,0.08);">

        <h2 style="margin:0 0 16px; color:#111;">
            Hello <%= name %> 👋
        </h2>

        <p style="font-size:15px; color:#555; line-height:1.6;">
            Use the OTP below to complete your verification process.
        </p>

        <div style="margin:24px 0; text-align:center;">
            <div
                style="display:inline-block; padding:16px 28px; font-size:28px; letter-spacing:6px; font-weight:bold; background:#f0f4ff; color:#1d4ed8; border-radius:10px;">
                <%= otp %>
            </div>
        </div>

        <p style="font-size:14px; color:#666; text-align:center;">
            This OTP will expire in <b style="color:#dc2626;">2 minutes</b>.
        </p>

        <hr style="border:none; border-top:1px solid #eee; margin:24px 0;" />

        <p style="font-size:12px; color:#999; text-align:center;">
            If you didn’t request this, you can safely ignore this email.
        </p>

    </div>

</body>

</html>