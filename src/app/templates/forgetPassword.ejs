<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <title>Reset Password</title>
</head>

<body style="margin:0; padding:0; font-family:Arial, sans-serif; background:#f4f6fb;">

    <div
        style="max-width:520px; margin:40px auto; background:#ffffff; padding:32px; border-radius:12px; box-shadow:0 10px 25px rgba(0,0,0,0.08);">

        <h2 style="margin:0 0 16px; color:#111;">
            Forgot your password?
        </h2>

        <p style="font-size:15px; color:#555; line-height:1.6;">
            Hi <b>
                <%= name %>
            </b>, we received a request to reset your password.
        </p>

        <p style="font-size:15px; color:#555;">
            Use the OTP below to reset your password:
        </p>

        <div style="text-align:center; margin:24px 0;">
            <div
                style="display:inline-block; padding:16px 28px; font-size:28px; letter-spacing:6px; font-weight:bold; background:#fff3f3; color:#dc2626; border-radius:10px;">
                <%= otp %>
            </div>
        </div>

        <p style="font-size:14px; color:#666; text-align:center;">
            This OTP will expire in <b style="color:#dc2626;">10 minutes</b>.
        </p>

        <hr style="border:none; border-top:1px solid #eee; margin:24px 0;" />

        <p style="font-size:12px; color:#999; text-align:center;">
            If you didn’t request this, you can safely ignore this email.
        </p>

    </div>

</body>

</html>